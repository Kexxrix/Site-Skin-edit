  "variants": [
    {
      "id": "A0",
      "family": "OutlineDepth",
      "name": "와이드 실버 · 기본 정리",
      "intent": "윤곽선을 카드 폭 93%까지 펼치고 인물 뒤에 배치. 하단 한글과 금색 버튼을 한 행으로 분리.",
      "tradeoff": "가장 균형 잡힌 기본안. 인물 교체 시 실루엣 마스크 조정 필요."
    },
    {
      "id": "A1",
      "family": "OutlineDepth",
      "name": "더블 골드 · 두 줄 캡션",
      "intent": "두 겹의 가는 금색 윤곽선과 큰 한글 제목. 바로가기는 아래쪽 독립 행의 분할형 금색 버튼.",
      "tradeoff": "금색의 존재감이 큼. 한글 제목과 버튼 사이 8px 여백 확보."
    },
    {
      "id": "A2",
      "family": "OutlineDepth",
      "name": "고스트 와이드 · 세로 한글",
      "intent": "넓은 반투명 윤곽선 아래에 한글 목적을 두 행으로 편집. 우측 금색 화살표 셀과 대비.",
      "tradeoff": "목적의 단어 단위가 또렷함. 영문은 정보보다 배경 그래픽 역할."
    },
    {
      "id": "A3",
