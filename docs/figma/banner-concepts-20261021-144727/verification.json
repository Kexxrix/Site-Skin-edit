  "designDirections": [
    {
      "id": "A",
      "name": "에디토리얼",
      "h": 340,
      "layout": "three",
      "intent": "사진은 장면으로, 정보는 지면으로. 밝은 캡션과 세리프 제목을 분리한 편집형.",
      "pros": "읽기 쉽고 인물·선물 장면을 가리지 않음. 이미지 교체에도 안정적.",
      "cons": "다크 화면에서 밝은 정보 면적이 눈에 띄며, 기존보다 높이가 늘어남.",
      "entry": "카드 전체 클릭 · 제목 옆 화살표가 진입점을 표시",
      "recommend": "균형 추천 · 가독성과 사진 보존을 우선할 때"
    },
    {
      "id": "B",
      "name": "와이드 챕터",
      "h": 672,
      "layout": "stack",
      "intent": "세 목적을 독립된 가로 챕터로 쌓는 디렉터리. 큰 제목과 여유 있는 읽기 흐름.",
      "pros": "목적 구분과 설명 가독성이 가장 명확함. 사진과 텍스트의 영역이 완전히 분리됨.",
      "cons": "배너 묶음이 672px로 높아져 아래 게임 콘텐츠가 많이 밀림.",
      "entry": "가로 행 전체 클릭 · 밑줄 링크와 우측 화살표",
      "recommend": "정보 전달 우선형 · 상단 혜택 영역의 비중을 크게 줄 때"
    },
    {
      "id": "C",
      "name": "시네마 포스터",
      "h": 384,
      "layout": "three",
      "intent": "세로 포스터 구도와 큰 두 줄 타이포그래피. 이미지별 빈 공간에 카피를 배치.",
      "pros": "인물 이미지의 존재감과 몰입도가 높음. 기존 서비스의 어두운 분위기와 자연스럽게 연결됨.",
      "cons": "작은 크기로 축소할 때 보조 문구의 대비를 계속 관리해야 함.",
      "entry": "포스터 전체 클릭 · 언더라인 액션과 화살표",
      "recommend": "비주얼 강조 후보 · 이미지의 매력을 가장 크게 보여주고 싶을 때"
    },
    {
      "id": "D",
      "name": "베네핏 티켓",
      "h": 216,
      "layout": "three",
      "intent": "사진 창·절취선·짧은 텍스트를 묶은 혜택 티켓. 컴팩트한 진입 도구로 해석.",
      "pros": "상단 높이를 절약하고 세 목적을 명료하게 구분. 텍스트가 사진과 겹치지 않음.",
      "cons": "사진 면적이 작아져 장면의 웅장함은 줄어듦. 종이 표현이 취향을 탈 수 있음.",
      "entry": "티켓 전체 클릭 · 하단 링크와 화살표",
      "recommend": "밀도 우선형 · 게임 콘텐츠를 위로 끌어올리고 싶을 때"
    },
    {
      "id": "E",
      "name": "포커스 스테이지",
      "h": 436,
      "layout": "asymmetric",
      "intent": "큰 페이백 장면과 두 개의 보조 배너. 크기 차이로 우선순위를 만드는 비대칭 무대.",
      "pros": "상단에 시선의 중심이 생기고 카드 3개의 기계적인 반복을 피함.",
      "cons": "페이백이 다른 두 목적보다 중요하다는 인상을 줌. 서비스 우선순위가 맞는지 확인 필요.",
      "entry": "각 카드 전체 클릭 · 텍스트 링크와 화살표",
      "recommend": "위계 강조형 · 페이백을 대표 진입점으로 둘 때"
    }
  ],
