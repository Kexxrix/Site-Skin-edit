-.skin-editor input[type=text],.skin-editor select {height:31px;min-width:0;width:100%;border:1px solid #c7cac2;border-radius:4px;padding:4px 7px;background:#fff;color:#292c2f;}
-.skin-editor .skin-hex {font-family:ui-monospace,Consolas,monospace;font-size:12px;text-transform:uppercase;}
-.skin-editor input[aria-invalid=true] {border-color:#a43434;}
-.skin-field-error {display:block;color:#a43434;font-size:10px;line-height:1.3;margin:3px 0 5px;}
-.skin-protected {margin-top:14px;padding:10px;background:#e8ebe3;border-radius:5px;color:#4d5e4f;font-size:11px;}
-.skin-warning {margin-top:12px;padding:10px;border:1px solid #dbbd79;border-radius:5px;background:#fff7df;color:#6e4b13;font-size:11px;}
-.skin-warning strong {display:block;font-size:12px;}
-.skin-warning ul {margin:5px 0;padding-left:16px;}
-.skin-warning small {font-size:10px;line-height:1.4;}
-.skin-inline {display:flex;gap:6px;align-items:center;margin:7px 0;}
-.skin-inline>input,.skin-inline>select {flex:1;}
-.skin-inline>button {flex:0 0 48px;height:31px;padding:4px 7px;}
-.skin-section>small {display:block;color:#686e6a;font-size:10px;line-height:1.45;margin-top:7px;}
-.skin-export {display:grid;grid-template-columns:1fr 1fr;gap:6px;}
-.skin-export button {font-size:11px;}
-.skin-export button:last-child {grid-column:1/-1;}
-.skin-notice,.skin-error {display:block;margin-top:12px!important;padding:10px;border-radius:5px;font-size:12px;}
-.skin-notice {background:#e8eee5;color:#355638;}
-.skin-error {background:#f8e9e6;color:#913832;border:1px solid #ddb2aa;}
-.skin-launcher {position:fixed;z-index:100;bottom:16px;right:16px;border:1px solid #b9b9b3;border-radius:6px;background:#f6f5f1;color:#292c2f;box-shadow:0 2px 8px #0003;padding:9px 14px;font-size:12px;font-weight:600;}
-.skin-launcher:hover {background:#ebece5;}
-.skin-launcher:focus-visible {outline:2px solid #315b48;outline-offset:2px;}
-/* The editor owns a separate lane at every viewport width. */
-body:has(.skin-workspace>.skin-editor) {min-width:2306px;}
-.skin-workspace:has(>.skin-editor) {display:flex;align-items:flex-start;gap:16px;width:2306px;margin-inline:auto;}
-.skin-workspace:has(>.skin-editor)>.mercury-site {flex:0 0 1920px;width:1920px;}
-.skin-workspace>.skin-editor {position:sticky;top:16px;right:auto;flex:0 0 370px;max-width:none;margin-top:16px;}
-.skin-gradient-stop {margin-top:10px;padding-top:8px;border-top:1px solid #d7dbd2;}
-.skin-gradient-stop>label {font-size:11px;font-weight:600;}
-.skin-gradient-stop .skin-inline>input[type=color] {flex:0 0 27px;}
-.skin-gold-group {padding:8px 0;border-bottom:1px solid #d4cab8;}
-.skin-gold-group:last-of-type {border-bottom:0;}
-.skin-gold-group>strong {display:block;margin-bottom:5px;font-size:11px;}
-.skin-gold-group[data-picked] {outline:1px solid #b39057;outline-offset:3px;}
