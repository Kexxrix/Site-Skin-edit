--- before-mercury-white.css
+++ app/mercury-white.css
@@ -265,3 +265,29 @@
     color-mix(in srgb, var(--skin-headerButton-050505) 86%, var(--white-button-text)) 100%);
   box-shadow: inset 0 1px 0 #ffffff26, inset 0 -1px 0 #2b28264d;
 }
+
+/* Separate the three header levels using the existing cream/gold/bronze palette. */
+.mc-shell {
+  --white-section-header-gradient: linear-gradient(180deg,
+    #fffaf0 0%, #f5e8c5 55%, #e2d3a9 calc(100% - 1px), #b8aa91 100%);
+}
+.mc-shell .mc-league-head {
+  background: var(--white-section-header-gradient);
+  border-bottom-color: var(--white-button-border);
+  box-shadow: inset 0 1px 0 #ffffff, 0 1px 2px #2b282617;
+}
+.mc-shell .mc-card {
+  background-image: var(--white-section-header-gradient);
+  /* Existing 12px top padding + 24px metadata + half of the 12px row gap. */
+  background-size: 100% 42px;
+  background-repeat: no-repeat;
+}
+.mc-shell .mc-match-heading {
+  background: linear-gradient(180deg, #806c49 0%, #6b481b 55%, #36312b 100%);
+  color: #fffaf0;
+  border-bottom-color: #6b481b;
+  box-shadow: inset 0 1px 0 #ffffff66, inset 0 -1px 0 #2b282666;
+}
+.mc-shell .mc-match-start {
+  color: inherit;
+}
